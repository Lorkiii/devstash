generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  vaultProfile  VaultEncryptionProfile?
}

// Only stable identity is retained; OAuth bearer tokens have no columns.
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fixed action IDs keep the limiter bounded without persisting IP addresses.
model AuthRateLimit {
  id              String   @id
  windowStartedAt DateTime
  count           Int
}

// Contains only public KDF metadata and authenticated wrapped key ciphertext.
// Passphrases, Recovery Phrases, and plaintext keys never enter this model.
model VaultEncryptionProfile {
  id                       String   @id @db.Uuid
  ownerId                  String   @unique
  profileFormatVersion     Int
  profileRevision          Int
  passphraseWrapRevision   Int
  recoveryWrapRevision     Int
  passphraseEncoding       String
  kdfAlgorithm             String
  kdfAlgorithmVersion      Int
  kdfSalt                  Bytes
  kdfMemoryKiB             Int
  kdfIterations            Int
  kdfParallelism           Int
  kdfOutputBytes           Int
  passphraseWrapAlgorithm  String
  passphraseWrapNonce      Bytes
  passphraseWrapTagBits    Int
  passphraseWrappedDek     Bytes
  recoveryPhraseEncoding   String
  recoveryKdfAlgorithm     String
  recoveryKdfSalt          Bytes
  recoveryKdfInfo          String
  recoveryKdfOutputBytes   Int
  recoveryWrapAlgorithm    String
  recoveryWrapNonce        Bytes
  recoveryWrapTagBits      Int
  recoveryWrappedDek       Bytes
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  owner                    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}
